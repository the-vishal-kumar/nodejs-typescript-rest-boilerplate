{
  "name": "nodejs-typescript-rest-boilerplate",
  "version": "1.0.0",
  "description": "Loan origination and weekly repayment REST API: Express 5, TypeScript, MongoDB, with validation, rate limiting, health checks and OpenAPI docs.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node build/index.js",
    "dev": "docker compose up --build",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects unit",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects e2e --runInBand",
    "typecheck": "tsc --noEmit",
    "contract": "npm run build && node -e \"process.stdout.write(JSON.stringify(require('./build/docs/openapi').openApiDocument, null, 2) + '\\n')\" > contract/openapi.json",
    "pretty": "prettier --write \"src/**/*.ts\"",
    "pretty:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "prepare": "husky || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-vishal-kumar/nodejs-typescript-rest-boilerplate.git"
  },
  "author": "Vishal Kumar <vishal194kumar@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/the-vishal-kumar/nodejs-typescript-rest-boilerplate/issues"
  },
  "homepage": "https://github.com/the-vishal-kumar/nodejs-typescript-rest-boilerplate#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "prettier": "^3.10.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "joi": "^18.3.2",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "mongoose": "^9.12.1",
    "newrelic": "^14.12.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
  },
  "engines": {
    "npm": ">=10",
    "node": ">=22"
  }
}
