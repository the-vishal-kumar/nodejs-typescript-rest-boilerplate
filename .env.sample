# Copy to .env. Every variable is validated at start-up (src/config/env.ts).
NODE_ENV=development
PORT=3000
# compose.yaml overrides this with the mongo service address.
MONGO_URI=mongodb://localhost:27017/ntrb
# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET_KEY=replace-me-with-the-output-of-openssl-rand-hex-32
USER_TOKEN_TTL_MINUTES=1440
ADMIN_TOKEN_TTL_MINUTES=20
# Lets anyone create an admin account. Keep false outside local demos.
ADMIN_SIGNUP_ENABLED=true
# Comma-separated list of allowed browser origins, or *
CORS_ORIGINS=*
# Set to 1 behind one reverse proxy so rate limits see the client IP.
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
SHUTDOWN_TIMEOUT_MS=10000
LOG_LEVEL=info
# json or pretty. Defaults to pretty in development and json elsewhere.
LOG_FORMAT=pretty
# Optional APM. The agent loads only when a licence key is set.
NEW_RELIC_APP_NAME=nodejs-typescript-rest-boilerplate
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APPLICATION_LOGGING_FORWARDING_ENABLED=true
NEW_RELIC_APPLICATION_LOGGING_FORWARDING_MAX_SAMPLES_STORED=100000
NEW_RELIC_APPLICATION_LOGGING_LOCAL_DECORATING_ENABLED=true
